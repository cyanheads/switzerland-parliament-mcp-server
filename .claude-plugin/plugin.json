{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "switzerland-parliament-mcp-server",
  "version": "0.1.0",
  "description": "Search Swiss parliamentary business, votes, debates, members, and declared interests via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/switzerland-parliament-mcp-server#readme",
  "repository": "https://github.com/cyanheads/switzerland-parliament-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "ai-agents", "ai-tools", "typescript", "bun", "stdio", "streamable-http", "cyanheads", "switzerland", "parliament", "curia-vista", "votes", "open-data"],
  "mcpServers": {
    "switzerland-parliament-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/switzerland-parliament-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
